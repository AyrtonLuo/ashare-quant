# Environment Configuration Template for Data Providers
# Copy this file to .env and populate your credentials securely.

# TuShare Pro API Token (Get token from https://tushare.pro)
TUSHARE_TOKEN=your_tushare_token_here

# Provider Configuration
PRIMARY_PROVIDER=tushare_pro_primary
SECONDARY_PROVIDER=akshare_secondary

# Rate Limits and Timeout Settings
PROVIDER_TIMEOUT_SECONDS=10.0
PROVIDER_MAX_RETRIES=3
